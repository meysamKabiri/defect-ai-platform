ENVIRONMENT=development
PROJECT_NAME=Defect AI Platform API
API_VERSION=1.0.0
API_PREFIX=/api/v1
ENABLE_DOCS=true
DATABASE_URL=mysql+aiomysql://root:Hello1234#@localhost:3306/defect_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0
ARQ_QUEUE_NAME=ai-inference
WORKER_MAX_JOBS=4
JOB_TIMEOUT_SECONDS=600
QUEUED_JOB_REPAIR_LIMIT=100
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
STREAM_TOKEN_EXPIRE_SECONDS=300
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_UPLOAD_SIZE_MB=20
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/defect-ai-uploads
DEFAULT_MODEL_NAME=surface-defect-detector
DEFAULT_MODEL_VERSION=2026.05.1
VITE_API_BASE_URL=/api/v1
